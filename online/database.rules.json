{
  "rules": {
    ".read": true,
    ".write": "auth != null",
    "settings": {
      ".validate": "newData.hasChildren(['whatsapp','restaurantName'])",
      "whatsapp": { ".validate": "newData.isString()" },
      "restaurantName": { ".validate": "newData.isString()" }
    },
    "menu": {
      "$item": {
        ".validate": "newData.hasChildren(['name','category','price','enabled'])",
        "name": { ".validate": "newData.isString()" },
        "category": { ".validate": "newData.isString()" },
        "price": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "enabled": { ".validate": "newData.isBoolean()" }
      }
    }
  }
}